{
  "name": "playwright-cucumber_framework",
  "version": "1.0.0",
  "description": "Playwright + Cucumber.js framework for SauceDemo with reusable Chai assertions",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:login": "cucumber-js --name \"Login with valid credentials\"",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:headless": "cross-env HEADLESS=true cucumber-js",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report": "npm run report:generate && npm run report:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "allure": "^3.22.1",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.14.0",
    "chai": "^4.5.0",
    "cross-env": "^10.1.0",
    "playwright": "^1.64.1"
  }
}
